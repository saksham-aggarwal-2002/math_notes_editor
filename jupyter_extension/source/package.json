{
  "name": "math_notes_editor-jupyter-bridge",
  "version": "0.1.0",
  "description": "Bridge between math_notes_editor and JupyterLab",
  "keywords": [
    "jupyter",
    "jupyterlab"
  ],
  "license": "MIT",
  "author": "math_notes_editor",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc && jupyter-builder build --development True .",
    "clean": "rm -rf lib math_notes_editor_jupyter_bridge/labextension"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.5.0",
    "@jupyterlab/notebook": "^4.5.0"
  },
  "devDependencies": {
    "@jupyter/builder": "^1.0.0",
    "typescript": "~5.9.3"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "math_notes_editor_jupyter_bridge/labextension"
  }
}